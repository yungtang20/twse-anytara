SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never prefix this key with VITE_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# HTML server modes are deliberately limited to cloud and test.
# Cloud never opens SQLite. Test requires SQLITE_DB_PATH under the OS temp directory.
MARKET_DATA_MODE=cloud
# Maximum number of missing market days fetched by one cloud update.
SUPABASE_SYNC_MAX_DAYS=14
# Server-only default for anonymous AI Research. Never expose this key to browser code.
HCNSEC_API_KEY=
HCNSEC_BASE_URL=https://api.hcnsec.cn/v1
HCNSEC_MODEL=auto
HCNSEC_MAX_OUTPUT_TOKENS=65536
# Anonymous AI abuse controls. Invalid values fail closed.
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_MS=600000
AI_SHARED_DAILY_LIMIT=100
AI_MAX_CONCURRENCY=2
FINMIND_API_KEY=
HOST=127.0.0.1
PORT=3000
# Required only by local administrative settings, diagnostics, and maintenance routes.
# Use a high-entropy value for server-only administrative endpoints. It is not used by AI Research.
TRINITY_ADMIN_TOKEN=
SQLITE_DB_PATH=
# Optional external integration; no application route depends on it.
MCP_ENABLED=false
