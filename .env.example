SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never prefix this key with VITE_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Cloud is the default. Set to local only for an isolated SQLite deployment.
MARKET_DATA_MODE=cloud
# Maximum number of missing market days fetched by one cloud update.
SUPABASE_SYNC_MAX_DAYS=14
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.2
FINMIND_API_KEY=
HOST=127.0.0.1
PORT=3000
SQLITE_DB_PATH=
# Used only when MARKET_DATA_MODE=local.
STARTUP_SYNC_ENABLED=true
MCP_ENABLED=true
TDCC_SCHEDULER_ENABLED=true
